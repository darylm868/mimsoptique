<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Optician on the East Coast | Scotch Plains, NJ | Mims Optique</title>
  <meta name="description" content="Welcome to Mims Optique. Our team is dedicated to providing a convenient and professional eyewear styling experience, whether virtually or at your preferred location." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --mo-gold: #C9A96E;
      --mo-dark: #1a1a1a;
      --mo-mid: #3d3d3d;
      --mo-light: #f7f5f0;
      --mo-white: #ffffff;
      --mo-accent: #8B6F47;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Jost', sans-serif;
      color: var(--mo-dark);
      background: var(--mo-white);
      overflow-x: hidden;
    }

    /* ── TOP BAR ── */
    .mo-topbar {
      background: var(--mo-dark);
      color: #ccc;
      font-size: 12px;
      text-align: center;
      padding: 8px 16px;
      letter-spacing: 0.5px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }
    .mo-topbar a { color: #ccc; text-decoration: none; transition: color .2s; }
    .mo-topbar a:hover { color: var(--mo-gold); }

    /* ── NAV ── */
    .mo-nav {
      background: var(--mo-white);
      border-bottom: 1px solid #e8e4dc;
      padding: 0 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      height: 70px;
    }
    .mo-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 400;
      letter-spacing: 2px;
      color: var(--mo-dark);
      text-transform: uppercase;
      text-decoration: none;
    }
    .mo-logo span { color: var(--mo-gold); }

    .mo-nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
      align-items: center;
    }
    .mo-nav-links a {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--mo-mid);
      text-decoration: none;
      transition: color .2s;
    }
    .mo-nav-links a:hover { color: var(--mo-gold); }

    .mo-hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 4px;
    }
    .mo-hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--mo-dark);
      transition: all .3s;
    }

    .mo-nav-btn {
      background: var(--mo-gold);
      color: var(--mo-white);
      border: none;
      padding: 10px 22px;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .2s;
      text-decoration: none;
      display: inline-block;
    }
    .mo-nav-btn:hover { background: var(--mo-accent); }

    /* ── HERO ── */
    .mo-hero {
      position: relative;
      background: #1a1a1a;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
    }
    .mo-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c9a96e' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .mo-hero-content {
      position: relative;
      z-index: 1;
      padding: 80px 24px;
      max-width: 680px;
    }
    .mo-hero-subtitle {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--mo-gold);
      margin-bottom: 18px;
    }
    .mo-hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(32px, 5vw, 54px);
      font-weight: 300;
      color: var(--mo-white);
      line-height: 1.2;
      margin-bottom: 22px;
    }
    .mo-hero p {
      font-size: 15px;
      color: rgba(255,255,255,0.6);
      line-height: 1.8;
      max-width: 460px;
      margin: 0 auto 36px;
    }
    .mo-hero-btns {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .mo-btn-primary {
      background: var(--mo-gold);
      color: var(--mo-white);
      border: none;
      padding: 15px 34px;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .2s;
      text-decoration: none;
      display: inline-block;
    }
    .mo-btn-primary:hover { background: var(--mo-accent); }
    .mo-btn-outline {
      background: transparent;
      color: var(--mo-white);
      border: 1px solid rgba(255,255,255,0.4);
      padding: 15px 34px;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: border-color .2s, color .2s;
      text-decoration: none;
      display: inline-block;
    }
    .mo-btn-outline:hover { border-color: var(--mo-gold); color: var(--mo-gold); }

    /* ── QUICK LINKS ── */
    .mo-quick-links {
      background: var(--mo-dark);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgba(201,169,110,0.3);
    }
    .mo-quick-link {
      padding: 22px 16px;
      text-align: center;
      border-right: 1px solid rgba(255,255,255,0.06);
      text-decoration: none;
      transition: background .2s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .mo-quick-link:last-child { border-right: none; }
    .mo-quick-link:hover { background: rgba(201,169,110,0.08); }
    .mo-quick-link i { font-size: 20px; color: var(--mo-gold); }
    .mo-quick-link span {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #aaa;
    }

    /* ── SECTIONS ── */
    .mo-section { padding: 80px 40px; }
    .mo-section-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--mo-gold);
      margin-bottom: 12px;
    }
    .mo-section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(26px, 3.5vw, 40px);
      font-weight: 300;
      color: var(--mo-dark);
      line-height: 1.2;
      margin-bottom: 20px;
    }
    .mo-section-text {
      font-size: 15px;
      color: #666;
      line-height: 1.8;
      max-width: 520px;
    }

    /* ── WELCOME ── */
    .mo-welcome { background: var(--mo-light); }
    .mo-welcome-inner {
      max-width: 960px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: center;
    }
    .mo-welcome-badge {
      display: inline-block;
      background: var(--mo-dark);
      color: var(--mo-gold);
      font-family: 'Jost', sans-serif;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      padding: 10px 20px;
      margin-top: 28px;
      cursor: pointer;
      border: none;
      transition: background .2s;
      text-decoration: none;
    }
    .mo-welcome-badge:hover { background: var(--mo-accent); color: var(--mo-white); }
    .mo-welcome-visual {
      background: var(--mo-dark);
      border-radius: 2px;
      height: 340px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .mo-glasses-svg { width: 180px; opacity: 0.9; }
    .mo-welcome-visual-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(201,169,110,0.12);
      padding: 18px;
      text-align: center;
      border-top: 1px solid rgba(201,169,110,0.25);
    }
    .mo-welcome-visual-caption p {
      font-family: 'Cormorant Garamond', serif;
      font-size: 16px;
      color: var(--mo-white);
      font-style: italic;
    }

    /* ── SERVICES ── */
    .mo-services { background: var(--mo-white); }
    .mo-services-inner { max-width: 960px; margin: 0 auto; }
    .mo-services-header { text-align: center; margin-bottom: 52px; }
    .mo-services-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .mo-service-card {
      border: 1px solid #e8e4dc;
      padding: 36px 30px;
      transition: border-color .2s, transform .2s;
      cursor: pointer;
      background: var(--mo-white);
    }
    .mo-service-card:hover { border-color: var(--mo-gold); transform: translateY(-3px); }
    .mo-service-icon {
      width: 48px;
      height: 48px;
      background: var(--mo-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }
    .mo-service-icon i { font-size: 22px; color: var(--mo-gold); }
    .mo-service-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 400;
      color: var(--mo-dark);
      margin-bottom: 10px;
    }
    .mo-service-card p {
      font-size: 14px;
      color: #888;
      line-height: 1.7;
      margin-bottom: 18px;
    }
    .mo-service-link {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--mo-gold);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .mo-service-link:hover { color: var(--mo-accent); }
    .mo-services-footer { text-align: center; margin-top: 40px; }

    /* ── TEAM ── */
    .mo-team {
      background: var(--mo-dark);
      padding: 80px 40px;
    }
    .mo-team-inner {
      max-width: 960px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 72px;
      align-items: center;
      justify-items: center;
    }
    .mo-team-photo {
      background: #221e1a;
      height: 380px;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(201,169,110,0.2);
    }
    .mo-team-initials {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: rgba(201,169,110,0.12);
      border: 2px solid rgba(201,169,110,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cormorant Garamond', serif;
      font-size: 36px;
      color: var(--mo-gold);
      letter-spacing: 2px;
    }
    .mo-team-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--mo-gold);
      margin-bottom: 14px;
    }
    .mo-team-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(28px, 3.5vw, 40px);
      font-weight: 300;
      color: var(--mo-white);
      margin-bottom: 8px;
    }
    .mo-team-role {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(201,169,110,0.65);
      margin-bottom: 22px;
    }
    .mo-team-bio {
      font-size: 14px;
      color: rgba(255,255,255,0.5);
      line-height: 1.85;
      margin-bottom: 30px;
    }
    .mo-btn-gold {
      background: transparent;
      color: var(--mo-gold);
      border: 1px solid rgba(201,169,110,0.5);
      padding: 12px 28px;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all .2s;
      text-decoration: none;
      display: inline-block;
    }
    .mo-btn-gold:hover { background: var(--mo-gold); color: var(--mo-white); border-color: var(--mo-gold); }

    /* ── TESTIMONIALS ── */
    .mo-testimonials { background: var(--mo-light); padding: 80px 40px; }
    .mo-testimonials-inner { max-width: 960px; margin: 0 auto; }
    .mo-test-header { text-align: center; margin-bottom: 52px; }
    .mo-test-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .mo-test-card {
      background: var(--mo-white);
      padding: 30px 26px;
      border: 1px solid #e8e4dc;
    }
    .mo-test-stars { display: flex; gap: 3px; margin-bottom: 14px; }
    .mo-test-stars i { font-size: 13px; color: var(--mo-gold); }
    .mo-test-text {
      font-size: 13px;
      color: #666;
      line-height: 1.85;
      margin-bottom: 22px;
      font-style: italic;
    }
    .mo-test-author { display: flex; align-items: center; gap: 12px; }
    .mo-author-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--mo-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: var(--mo-gold);
      flex-shrink: 0;
    }
    .mo-author-name { font-size: 13px; font-weight: 600; color: var(--mo-dark); }
    .mo-author-label { font-size: 11px; color: #aaa; }

    /* ── MAP ── */
    .mo-map-section { background: var(--mo-white); padding: 0; }
    .mo-map-section iframe { display: block; width: 100%; height: 400px; border: none; }

    /* ── CTA BAR ── */
    .mo-cta-bar {
      background: var(--mo-gold);
      padding: 52px 40px;
      text-align: center;
    }
    .mo-cta-bar h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(24px, 3vw, 34px);
      font-weight: 300;
      color: var(--mo-white);
      margin-bottom: 20px;
      letter-spacing: 1px;
    }
    .mo-btn-white {
      background: var(--mo-white);
      color: var(--mo-gold);
      border: none;
      padding: 14px 32px;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all .2s;
      text-decoration: none;
      display: inline-block;
    }
    .mo-btn-white:hover { background: var(--mo-dark); color: var(--mo-white); }

    /* ── FOOTER ── */
    .mo-footer {
      background: var(--mo-dark);
      padding: 64px 40px 28px;
      color: rgba(255,255,255,0.5);
    }
    .mo-footer-inner { max-width: 960px; margin: 0 auto; }
    .mo-footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 56px;
      margin-bottom: 52px;
    }
    .mo-footer-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--mo-white);
      margin-bottom: 14px;
      text-decoration: none;
      display: block;
    }
    .mo-footer-logo span { color: var(--mo-gold); }
    .mo-footer-desc { font-size: 13px; line-height: 1.75; margin-bottom: 22px; }
    .mo-footer-social { display: flex; gap: 10px; }
    .mo-social-btn {
      width: 36px;
      height: 36px;
      border: 1px solid rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: border-color .2s, color .2s;
      text-decoration: none;
      color: rgba(255,255,255,0.5);
    }
    .mo-social-btn:hover { border-color: var(--mo-gold); color: var(--mo-gold); }
    .mo-social-btn i { font-size: 16px; }
    .mo-footer-heading {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--mo-gold);
      margin-bottom: 18px;
    }
    .mo-footer-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .mo-footer-list li {
      font-size: 13px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    .mo-footer-list i { font-size: 15px; color: var(--mo-gold); flex-shrink: 0; margin-top: 1px; }
    .mo-footer-list a { color: rgba(255,255,255,0.5); text-decoration: none; transition: color .2s; }
    .mo-footer-list a:hover { color: var(--mo-gold); }
    .mo-footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 11px;
    }
    .mo-footer-links { display: flex; gap: 20px; flex-wrap: wrap; }
    .mo-footer-links a { color: rgba(255,255,255,0.35); text-decoration: none; transition: color .2s; }
    .mo-footer-links a:hover { color: var(--mo-gold); }

    /* ── MOBILE MENU ── */
    .mo-mobile-menu {
      display: none;
      position: fixed;
      top: 70px;
      left: 0;
      right: 0;
      background: var(--mo-white);
      border-bottom: 2px solid var(--mo-gold);
      padding: 20px 24px;
      z-index: 99;
      flex-direction: column;
      gap: 16px;
    }
    .mo-mobile-menu.open { display: flex; }
    .mo-mobile-menu a {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--mo-mid);
      text-decoration: none;
      padding: 8px 0;
      border-bottom: 1px solid #f0ece4;
    }
    .mo-mobile-menu a:last-child { border-bottom: none; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .mo-nav { padding: 0 20px; }
      .mo-nav-links { display: none; }
      .mo-nav-btn { display: none; }
      .mo-hamburger { display: flex; }
      .mo-section { padding: 56px 20px; }
      .mo-welcome-inner { grid-template-columns: 1fr; gap: 36px; }
      .mo-services-grid { grid-template-columns: 1fr; }
      .mo-team-inner { grid-template-columns: 1fr; gap: 36px; }
      .mo-team-photo { height: 220px; }
      .mo-test-grid { grid-template-columns: 1fr; }
      .mo-footer-grid { grid-template-columns: 1fr; gap: 36px; }
      .mo-footer-bottom { flex-direction: column; align-items: flex-start; }
      .mo-quick-links { grid-template-columns: repeat(3, 1fr); }
      .mo-team { padding: 56px 20px; }
      .mo-testimonials { padding: 56px 20px; }
      .mo-cta-bar { padding: 48px 20px; }
      .mo-footer { padding: 48px 20px 24px; }
      .mo-topbar { gap: 12px; font-size: 11px; }
    }

    @media (max-width: 480px) {
      .mo-quick-links { grid-template-columns: 1fr; }
      .mo-quick-link { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06); flex-direction: row; justify-content: center; gap: 10px; }
    }
  </style>
</head>
<body>

  <!-- TOP BAR -->
  <div class="mo-topbar">
    <span><i class="ti ti-map-pin" style="font-size:13px; margin-right:4px; color:#c9a96e"></i>2389 Mountain Ave Suite 3, Scotch Plains, NJ 07076</span>
    <span><i class="ti ti-phone" style="font-size:13px; margin-right:4px; color:#c9a96e"></i><a href="tel:9088236467">(908) 823-6467</a></span>
    <span>★★★★★ <a href="http://search.google.com/local/writereview?placeid=ChIJweHnN2uxw4kR02lHhlWWxoI" target="_blank" rel="noopener">Leave a Review</a></span>
  </div>

  <!-- NAV -->
  <nav class="mo-nav">
    <a href="#" class="mo-logo">Mims <span>Optique</span></a>
    <ul class="mo-nav-links">
      <li><a href="#">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="https://shop.mimsoptique.com/" target="_blank" rel="noopener">Browse Frames</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
